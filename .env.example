# ==============================================================================
# IT Stok Takip Sistemi - Çevre Değişkenleri Şablonu (.env.example)
# ==============================================================================

# Veritabanı Bağlantısı (PostgreSQL / Supabase / Neon / Docker)
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/it_stok_takip?schema=public"

# Auth.js / NextAuth Gizli Anahtarı (En az 32 karakter rastgele string)
# Üretmek için: openssl rand -base64 32
NEXTAUTH_SECRET="ornek_cok_gizli_nextauth_anahtari_1234567890"
AUTH_SECRET="ornek_cok_gizli_nextauth_anahtari_1234567890"

# Uygulama URL'i (Opsiyonel / Canlıda zorunlu)
# NEXTAUTH_URL="https://stok.sirketiniz.com"
