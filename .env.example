# ==============================================================================
# IT Stok Takip Sistemi - Çevre Değişkenleri Şablonu
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun. ".env" ASLA commit edilmez.
# ==============================================================================

# Veritabanı Bağlantısı (PostgreSQL / Supabase / Neon / Docker)
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/it_stok_takip?schema=public"

# Auth.js / NextAuth gizli anahtarı — üretmek için: openssl rand -base64 32
AUTH_SECRET=""
# NextAuth v4 uyumluluğu için aynı değer (opsiyonel)
NEXTAUTH_SECRET=""

# Uygulama URL'i (canlıda zorunlu)
# NEXTAUTH_URL="https://stok.sirketiniz.com"

# ------------------------------------------------------------------------------
# Opsiyonel
# ------------------------------------------------------------------------------

# Sistemdeki azami kullanıcı sayısı (varsayılan 5)
# MAX_USERS="5"

# İlk yöneticiyi seed ile oluşturmak isterseniz (boş bırakılırsa /signup ekranından oluşturulur).
# Şifre en az 8 karakter olmalıdır ve kaynak koda yazılmaz.
# SEED_ADMIN_EMAIL="admin@sirketiniz.com"
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_NAME="Sistem Yöneticisi"
# SEED_ADMIN_PASSWORD=""
